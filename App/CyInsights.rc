#include "ResourceIds.h"
#include <winver.h>
IDI_CYINSIGHTS ICON "cyinsights-logo-v1.ico"
IDR_CYINSIGHTS_LOGO RCDATA "cyinsights-logo-ui-v1.png"
IDR_CYINSIGHTS_AI_CATALOG RCDATA "CyTool.json"
IDR_CYINSIGHTS_AI_METHOD RCDATA "analysis-method.json"
IDR_CYINSIGHTS_AI_LOCALES RCDATA "ui.json"

// Publisher metadata is descriptive; it is not an Authenticode signature.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS @CYINSIGHTS_RESOURCE_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Cyberalien\0"
   VALUE "FileDescription", "CyInsights Unreal trace and GPU analysis\0"
   VALUE "FileVersion", "@CYINSIGHTS_UPDATE_VERSION@\0"
   VALUE "InternalName", "CyInsightsApp\0"
   VALUE "OriginalFilename", "CyInsightsApp.exe\0"
   VALUE "ProductName", "CyInsights\0"
   VALUE "ProductVersion", "@CYINSIGHTS_UPDATE_VERSION@\0"
   VALUE "LegalCopyright", "Copyright (C) 2026 Cyberalien. AGPL-3.0-or-later.\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
