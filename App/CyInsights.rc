   VALUE "ProductName", "CyInsights\0"
   VALUE "ProductVersion", "0.1.1\0"
   VALUE "LegalCopyright", "Copyright (C) 2026 Cyberalien. AGPL-3.0-or-later.\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
